{
  "name": "adb-ai-test-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Safe, local-only Android ADB test studio with human-approved AI tooling (MCP)",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "core",
    "mcp-bridge",
    "app"
  ],
  "scripts": {
    "build": "tsc -p core && tsc -p mcp-bridge",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "typecheck": "tsc -p core --noEmit && tsc -p mcp-bridge --noEmit && npm run typecheck -w @adbstudio/app",
    "agent": "node core/dist/cli.js",
    "bridge": "node mcp-bridge/dist/index.js",
    "app:dev": "npm run dev -w @adbstudio/app",
    "app:build": "npm run build -w @adbstudio/app",
    "app:start": "npm run build -w @adbstudio/app && npm run start -w @adbstudio/app",
    "app:package": "npm run package -w @adbstudio/app"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
